# 服务端口
PORT=3000

# 数据库（MySQL 8）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=blog

# TypeORM
# 开发期默认开启 synchronize（自动建表），便于快速联调；
# 生产环境务必设为 false，并改用正式数据库迁移。
DB_SYNC=true

# JWT
# ⚠️ 生产环境必须替换为高强度随机密钥，切勿使用默认值。
# 可用 `openssl rand -base64 48` 生成。
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
