{
  "name": "blog-platform",
  "version": "1.0.0",
  "private": true,
  "description": "现代化博客系统 Monorepo（前端展示端 + 管理后台 + 后端服务）",
  "license": "MIT",
  "author": "Blog Platform Contributors",
  "keywords": [
    "blog",
    "blog-platform",
    "monorepo",
    "nestjs",
    "nextjs",
    "react",
    "ant-design",
    "typescript",
    "mysql",
    "typeorm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0end1/blog-platform.git"
  },
  "bugs": {
    "url": "https://github.com/0end1/blog-platform/issues"
  },
  "homepage": "https://github.com/0end1/blog-platform#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @blog/backend",
    "dev:frontend": "npm run dev --workspace @blog/frontend",
    "dev:admin": "npm run dev --workspace @blog/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "browserslist": "^4.28.6",
    "caniuse-lite": "^1.0.30001806",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.1.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "@rc-component/color-picker": "~2.0.1",
    "@rc-component/mutate-observer": "^1.1.0",
    "@rc-component/qrcode": "~2.0.0",
    "@rc-component/tour": "~1.15.1",
    "@rc-component/trigger": "^2.3.0",
    "rc-cascader": "~3.34.0",
    "rc-checkbox": "~3.5.0",
    "rc-collapse": "~3.9.0",
    "rc-dialog": "~9.6.0",
    "rc-drawer": "~7.3.0",
    "rc-dropdown": "~4.2.1",
    "rc-field-form": "~2.7.1",
    "rc-image": "~7.12.0",
    "rc-input": "~1.8.0",
    "rc-input-number": "~9.5.0",
    "rc-mentions": "~2.20.0",
    "rc-menu": "~9.16.1",
    "rc-motion": "^2.9.5",
    "rc-notification": "~5.6.4",
    "rc-pagination": "~5.1.0",
    "rc-picker": "~4.11.3",
    "rc-progress": "~4.0.0",
    "rc-rate": "~2.13.1",
    "rc-resize-observer": "^1.4.3",
    "rc-segmented": "~2.7.0",
    "rc-select": "~14.16.8",
    "rc-slider": "~11.1.9",
    "rc-steps": "~6.0.1",
    "rc-switch": "~4.1.0",
    "rc-table": "~7.54.0",
    "rc-tabs": "~15.7.0",
    "rc-textarea": "~1.10.2",
    "rc-tooltip": "~6.4.0",
    "rc-tree": "~5.13.1",
    "rc-tree-select": "~5.27.0",
    "rc-upload": "~4.11.0",
    "rc-util": "^5.44.4",
    "passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0"
  }
}
